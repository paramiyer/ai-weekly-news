# ai-news bot — config template. Copy to config.env and fill in. config.env is gitignored.
BOT_DIR="/absolute/path/to/ai-news"
SEND_JID="<recipient>@s.whatsapp.net"    # a person (beta) or a group JID
GROUP_JID=""                             # optional: the group JID to graduate to
ALERT_JID="<your-number>@s.whatsapp.net" # where failure alerts go
BRIDGE_URL="http://localhost:8080/api/send"   # whatsapp-mcp Go bridge
TZ_SEND="Asia/Dubai"
SEND_HOUR="8"
SEND_MIN="0"
SWEEP_CAP="280"
